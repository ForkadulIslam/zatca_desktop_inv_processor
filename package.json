{
  "name": "hello-electron-vue",
  "version": "1.0.0",
  "description": "Electron + Vue 3 + Tailwind CSS Starter",
  "main": "main.js",
  "scripts": {
    "watch": "concurrently -k \"vite\" \"electron .\"",
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build": "vite build",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^45.3.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
